# Variáveis da API (modelo). Copie para .env só se precisar; o .env nunca vai para o Git.
# No computador nada disso é obrigatório: sem DB_URL, a API usa o H2 em memória.
# No Render, cadastre cada uma em Environment.

# Porta (o Render define sozinho)
PORT=8080

# Banco Postgres. No Render, o render.yaml já preenche DATABASE_URL sozinho
# (postgresql://usuario:senha@host/banco) e a API converte para JDBC.
# Para configurar à mão, use DB_URL (JDBC) + DB_USUARIO + DB_SENHA, que têm prioridade.
DATABASE_URL=postgresql://antidoto:troque-esta-senha@host-do-banco/antidoto
# DB_URL=jdbc:postgresql://host-do-banco:5432/antidoto
# DB_USUARIO=antidoto
# DB_SENHA=troque-esta-senha

# Segredo do JWT em base64, com 32+ bytes. Gere com: openssl rand -base64 32
JWT_SECRET=troque-por-um-segredo-em-base64

# Origens do navegador que podem chamar a API (o app no celular não precisa)
CORS_ORIGENS=http://localhost:8081

# false desliga os usuários de teste
CARREGAR_DADOS_INICIAIS=true

# IA do resumo de pré-atendimento (Groq). Sem IA_HABILITADA=true, vale o modelo padrão.
# A chave é criada em https://console.groq.com/keys e NUNCA vai para o Git nem para o app.
IA_HABILITADA=false
GROQ_API_KEY=gsk_sua-chave-aqui
# Opcionais: o modelo e o endereço da API (compatível com a OpenAI)
# IA_MODELO=openai/gpt-oss-120b
# IA_URL=https://api.groq.com/openai/v1
